<?xml version="1.0" encoding="UTF-8"?>
<!-- 仅注册打开方式，不写扩展名默认值。 -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <DirectoryRef Id="INSTALLDIR">
      <Component Id="MoraFileOpenChoices" Guid="a7ec1341-0fae-4d66-b9bc-ea8535eaa759" Win64="yes">
        <RegistryKey Root="HKMU" Key="Software\Classes\com.mora.desktop.mdx">
          <RegistryValue Type="string" Value="Mora MDXNote" KeyPath="yes" />
          <RegistryKey Key="DefaultIcon"><RegistryValue Type="string" Value="&quot;[INSTALLDIR]mora.exe&quot;,0" /></RegistryKey>
          <RegistryKey Key="shell\open\command"><RegistryValue Type="string" Value="&quot;[INSTALLDIR]mora.exe&quot; &quot;%1&quot;" /></RegistryKey>
        </RegistryKey>
        <RegistryKey Root="HKMU" Key="Software\Classes\com.mora.desktop.markdown">
          <RegistryValue Type="string" Value="Mora Markdown" />
          <RegistryKey Key="DefaultIcon"><RegistryValue Type="string" Value="&quot;[INSTALLDIR]mora.exe&quot;,0" /></RegistryKey>
          <RegistryKey Key="shell\open\command"><RegistryValue Type="string" Value="&quot;[INSTALLDIR]mora.exe&quot; &quot;%1&quot;" /></RegistryKey>
        </RegistryKey>
        <RegistryKey Root="HKMU" Key="Software\Classes\.mdx\OpenWithProgids">
          <RegistryValue Type="string" Name="com.mora.desktop.mdx" Value="" />
        </RegistryKey>
        <RegistryKey Root="HKMU" Key="Software\Classes\.md\OpenWithProgids">
          <RegistryValue Type="string" Name="com.mora.desktop.markdown" Value="" />
        </RegistryKey>
        <RegistryKey Root="HKMU" Key="Software\Classes\.markdown\OpenWithProgids">
          <RegistryValue Type="string" Name="com.mora.desktop.markdown" Value="" />
        </RegistryKey>
      </Component>
    </DirectoryRef>
  </Fragment>
</Wix>
