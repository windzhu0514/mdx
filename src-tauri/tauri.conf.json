{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Mora",
    "version": "0.1.1",
    "identifier": "com.mora.desktop",
    "build": {
        "beforeDevCommand": "npm run dev",
        "devUrl": "http://127.0.0.1:1420",
        "beforeBuildCommand": "npm run build && npm run prepare:agent",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "label": "main",
                "title": "Mora 墨笺",
                "width": 1040,
                "height": 760,
                "minWidth": 760,
                "minHeight": 520,
                "visible": false,
                "decorations": false
            }
        ],
        "security": {
            "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "createUpdaterArtifacts": true,
        "externalBin": ["binaries/mora-agent"],
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "windows": {
            "wix": {
                "language": "zh-CN"
            },
            "nsis": {
                "languages": ["SimpChinese"],
                "displayLanguageSelector": false
            }
        },
        "macOS": {
            "signingIdentity": "-"
        }
    },
    "plugins": {
        "updater": {
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUxMjNGRkRDRjk1NjAzNEYKUldSUEExYjUzUDhqNFpyWDV4R3RNSk9aRGdpOHhBR3ZMS1VSVEtYRC9GMjBKVTZub1VZZWR2aSsK",
            "endpoints": [
                "https://github.com/windzhu0514/mdx/releases/latest/download/latest.json"
            ],
            "windows": {
                "installMode": "passive"
            }
        }
    }
}
