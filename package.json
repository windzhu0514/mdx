{
    "name": "mora",
    "private": true,
    "version": "0.1.2",
    "type": "module",
    "scripts": {
        "dev": "vite --host 127.0.0.1",
        "build": "vue-tsc --noEmit && vite build",
        "build:exe": "tauri build --no-bundle",
        "prepare:agent": "node scripts/prepare-agent-sidecar.mjs",
        "preview": "vite preview",
        "tauri": "tauri",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:release": "node --test scripts/check-release-version.test.mjs",
        "release:check": "node scripts/check-release-version.mjs",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check \"src/**/*.{ts,vue,css}\" \"scripts/**/*.mjs\" \"*.{ts,js,mjs,css,html,json,md}\" \"!TODO.md\" \".github/**/*.{yml,yaml}\" \"src-tauri/**/*.json\" \"docs/RELEASE.md\""
    },
    "dependencies": {
        "@codemirror/commands": "6.10.4",
        "@codemirror/lang-markdown": "6.5.1",
        "@codemirror/language": "6.12.4",
        "@codemirror/language-data": "6.5.2",
        "@codemirror/state": "6.7.1",
        "@milkdown/crepe": "7.21.3",
        "@milkdown/kit": "7.21.3",
        "@tauri-apps/api": "2.11.0",
        "@tauri-apps/plugin-dialog": "2.7.1",
        "@tauri-apps/plugin-process": "^2.3.1",
        "@tauri-apps/plugin-updater": "^2.10.1",
        "codemirror": "6.0.2",
        "mermaid": "11.16.1",
        "vue": "3.5.34"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@tauri-apps/cli": "^2.2.7",
        "@vitejs/plugin-vue": "6.0.6",
        "eslint": "^10.7.0",
        "eslint-plugin-vue": "^10.9.2",
        "globals": "^17.7.0",
        "jsdom": "^26.1.0",
        "prettier": "^3.9.5",
        "typescript": "6.0.3",
        "typescript-eslint": "^8.64.0",
        "vite": "8.1.5",
        "vitest": "3.2.7",
        "vue-tsc": "3.2.8"
    },
    "overrides": {
        "dompurify": "3.4.12"
    }
}
